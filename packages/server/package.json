{
  "name": "@dnd/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate --config-file .node-pg-migraterc.json up",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate --config-file .node-pg-migraterc.json down",
    "migrate:create": "node-pg-migrate create --config-file .node-pg-migraterc.json",
    "seed": "dotenv -e ../../.env -- tsx src/db/seeds/run.ts",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
