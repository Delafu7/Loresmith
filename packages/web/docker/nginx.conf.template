# Templated by the nginx:*-alpine image's docker-entrypoint.d envsubst step
# (BACKEND_HOST/BACKEND_PORT only — nginx's own $host/$remote_addr/etc.
# aren't real environment variables, so envsubst leaves them untouched).
#
# Mirrors packages/web/vite.config.ts's dev proxy exactly: the SPA's fetch()
# calls and its Socket.io client both use same-origin, unprefixed paths
# (no /api prefix — see lib/api.ts/lib/socket.ts), so this proxies the same
# set of top-level route prefixes to the backend rather than serving them
# as static files.
#
# Some of those prefixes are genuinely ambiguous: e.g. /campaigns/1/characters
# is BOTH a real REST endpoint (the SPA's own fetch() calls it) AND a real
# frontend route (CampaignShell's nested "characters" route) — vite.config.ts
# disambiguates the exact same ambiguity by checking whether the request
# looks like a browser navigation (`Accept: text/html...`) vs a same-origin
# fetch/XHR (this app's api.ts never sets an explicit Accept, so it stays
# `*/*`). Reproduced here via the map+error_page idiom, since nginx has no
# `if` that can branch a single location between proxy_pass and try_files.
map $http_accept $loresmith_wants_html {
    default 0;
    "~*^text/html" 1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /socket.io/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(auth|me|campaigns|characters|monster-instances|encounters|effects|catalog|assets|uploads|health)(/|$) {
        error_page 418 = @spa_fallback;
        if ($loresmith_wants_html) {
            return 418;
        }
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A hard navigation/reload on one of the ambiguous paths above lands
    # here instead of being proxied — same "always fall through to
    # index.html for a real page load" outcome as the plain SPA fallback
    # below, just reached from inside the API-prefix location instead of
    # missing it entirely.
    location @spa_fallback {
        try_files /index.html =404;
    }

    # SPA fallback for every other path — anything not under an API prefix
    # is a real page, so it always resolves to index.html rather than a 404.
    location / {
        try_files $uri /index.html;
    }
}
